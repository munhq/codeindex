{
  "version": 1,
  "github": "munhq/codeindex",
  "store": "server",
  "server": {
    "url": "https://desk.munhq.com",
    "tokenEnv": "DESK_TOKEN"
  },
  "validation": [
    {
      "name": "npm:syntax",
      "command": "find . -name node_modules -prune -o \\( -name '*.js' -o -name '*.mjs' -o -name '*.cjs' \\) -print0 | xargs -0 -r -n1 node --check",
      "cwd": "npm",
      "stage": "land",
      "paths": [
        "npm/**/*.js",
        "npm/**/*.mjs",
        "npm/**/*.cjs",
        "npm/package.json"
      ]
    },
    {
      "name": "versions",
      "command": "python3 check-versions.py",
      "stage": "land",
      "paths": [
        "npm/package.json",
        "plugin/.claude-plugin/plugin.json",
        "server.json",
        ".cursor-plugin/marketplace.json",
        "zig/build.zig",
        "zig/build.zig.zon",
        "check-versions.py"
      ]
    },
    {
      "name": "zig:fmt",
      "command": "/opt/zig-0.16/zig fmt --check src/ main.zig build.zig tests_main.zig",
      "cwd": "zig",
      "stage": "land",
      "paths": [
        "zig/**",
        ".desk/config.json"
      ]
    },
    {
      "name": "zig:build",
      "command": "/opt/zig-0.16/zig build",
      "setup": "./fetch-vendor.sh",
      "cwd": "zig",
      "stage": "land",
      "paths": [
        "zig/**",
        ".desk/config.json"
      ]
    },
    {
      "name": "zig:test",
      "command": "/opt/zig-0.16/zig build test-bin && ./zig-out/bin/test",
      "setup": "./fetch-vendor.sh",
      "cwd": "zig",
      "stage": "land",
      "paths": [
        "zig/**",
        ".desk/config.json"
      ]
    }
  ]
}
