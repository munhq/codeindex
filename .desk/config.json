{
  "version": 1,
  "github": "munhq/codeindex",
  "store": "server",
  "server": {
    "url": "https://desk.munhq.com",
    "tokenEnv": "DESK_TOKEN"
  },
  "validation": [
    {
      "name": "root",
      "command": "DESK_BUCK_TOOLCHAIN=\"zig $(/opt/zig-0.16/zig version)\" sh .desk/workflows/buck-base/scripts/buck-run.sh build //:check",
      "timeoutMinutes": 30,
      "paths": [
        "zig/**",
        "BUCK",
        ".buckconfig",
        ".desk/config.json"
      ]
    },
    {
      "name": "npm:syntax",
      "command": "find . -name node_modules -prune -o \\( -name '*.js' -o -name '*.mjs' -o -name '*.cjs' \\) -print0 | xargs -0 -r -n1 node --check",
      "cwd": "npm",
      "stage": "land",
      "paths": [
        "npm/**/*.js",
        "npm/**/*.mjs",
        "npm/**/*.cjs",
        "npm/package.json"
      ]
    },
    {
      "name": "versions",
      "command": "python3 check-versions.py",
      "stage": "land",
      "paths": [
        "npm/package.json",
        "plugin/.claude-plugin/plugin.json",
        "server.json",
        ".cursor-plugin/marketplace.json",
        "zig/build.zig",
        "zig/build.zig.zon",
        "check-versions.py"
      ]
    }
  ],
  "budget": {
    "mode": "refuse",
    "checkSeconds": 60,
    "checks": {}
  },
  "checkouts": [
    {
      "repo": "munhq/desk",
      "path": ".desk/workflows/buck-base",
      "at": 579,
      "subpath": "workflows/buck-base"
    },
    {
      "repo": "munhq/desk",
      "path": ".desk/workflows/buck-node",
      "at": 579,
      "subpath": "workflows/buck-node"
    },
    {
      "repo": "munhq/desk",
      "path": ".desk/workflows/buck-zig",
      "at": 579,
      "subpath": "workflows/buck-zig"
    }
  ]
}
