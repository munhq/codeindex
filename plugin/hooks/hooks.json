{
  "description": "Points the agent at a structural query the first time a session reads or greps for a code answer.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read|Grep|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/first-read-hint.sh\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
