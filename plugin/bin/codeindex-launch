#!/bin/sh
# Launch the codeindex MCP server for the Claude Code plugin.
#
# The plugin ships skills and this launcher, never a binary: codeindex is a
# compiled Zig program of about 53 MB per platform, and carrying four builds
# would make the plugin mostly dead weight for every user. An npm-published
# server gets this for free through npx, so a compiled one needs the equivalent —
# resolve a usable binary, and fetch one only when nothing usable exists.
#
# Write NOTHING to stdout. Stdout is the JSON-RPC channel. One stray line there
# makes the server look broken to the client, with no error that explains why.
# Diagnostics go to stderr, which the client logs.
set -eu

BIN_NAME="codeindex"
# Windows will not execute a file without the .exe extension, so the cached
# binary and the names searched below carry it. Empty everywhere else.
case "$(uname -s)" in
    MINGW*|MSYS*|CYGWIN*|Windows_NT) EXE=".exe" ;;
    *) EXE="" ;;
esac
REPO="munhq/codeindex"
CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/codeindex/bin"

log() { printf '%s\n' "$*" >&2; }

# Map uname onto the names the release actually publishes. The release matrix in
# .github/workflows/release.yml builds Zig target triples — x86_64-linux,
# aarch64-linux, x86_64-macos, aarch64-macos — and uname does not agree with any
# of them on a Mac: `uname -s` says Darwin, not macos, and Apple Silicon reports
# arm64, not aarch64. So this asked for codeindex-arm64-darwin, which 404s, and
# every Mac fell through to a source build. It said "No prebuilt binary", which
# reads as a statement about the release rather than the bug it was.
# plugin/test_platform.sh checks this against the matrix, so adding a target
# without a mapping fails there instead of in a stranger's terminal.
resolve_artifact() {
    _arch="$(uname -m)"
    _os="$(uname -s)"
    case "$_arch" in
        x86_64|amd64) _arch=x86_64 ;;
        arm64|aarch64) _arch=aarch64 ;;
        *) return 1 ;;
    esac
    # Git Bash, MSYS2 and Cygwin all report a decorated kernel name rather than
    # anything containing "windows", e.g. MINGW64_NT-10.0-22631. A shell on
    # Windows is the only way these scripts run there at all.
    _ext=""
    case "$_os" in
        Linux) _os=linux ;;
        Darwin) _os=macos ;;
        MINGW*|MSYS*|CYGWIN*|Windows_NT) _os=windows; _ext=".exe" ;;
        *) return 1 ;;
    esac
    printf '%s-%s-%s%s\n' "$1" "$_arch" "$_os" "$_ext"
}

# Introspection used by plugin/test_platform.sh. Placed before every exec so the
# test never launches a server.
if [ "${1:-}" = "--artifact" ]; then
    resolve_artifact "$BIN_NAME" || { echo "unsupported"; exit 1; }
    exit 0
fi

# 1. An explicit override wins, for a local build or an unusual layout.
if [ -n "${CODEINDEX_BIN:-}" ] && [ -x "${CODEINDEX_BIN}" ]; then
    exec "${CODEINDEX_BIN}" "$@"
fi

# 2. An already-installed binary. PATH first, then the directory install.sh
#    writes to, which is not always on PATH, then this launcher's own cache.
if command -v "$BIN_NAME" >/dev/null 2>&1; then
    exec "$(command -v "$BIN_NAME")" "$@"
fi
for candidate in "$HOME/.local/bin/$BIN_NAME$EXE" "$CACHE_DIR/$BIN_NAME$EXE"; do
    if [ -x "$candidate" ]; then
        exec "$candidate" "$@"
    fi
done

# 3. Nothing installed. Fetch the release build for this platform once and cache
#    it, so this path runs on first launch only. The release names assets
#    <binary>-<arch>-<os>, matching uname, so this must agree with install.sh.

if ! ARTIFACT="$(resolve_artifact "$BIN_NAME")"; then
    log "codeindex: no release build for $(uname -m)-$(uname -s)."
    log "  build it: git clone https://github.com/$REPO && cd codeindex && ./install.sh"
    exit 127
fi
mkdir -p "$CACHE_DIR"
TMP="$CACHE_DIR/.${BIN_NAME}.download.$$"
rm -f "$TMP"

# curl first: the releases are public, so this needs no credentials and no gh.
if command -v curl >/dev/null 2>&1 &&
   curl -fsSL -o "$TMP" \
     "https://github.com/$REPO/releases/latest/download/$ARTIFACT"; then
    chmod 0755 "$TMP"
    mv -f "$TMP" "$CACHE_DIR/$BIN_NAME$EXE"
    log "codeindex: fetched $ARTIFACT -> $CACHE_DIR/$BIN_NAME$EXE"
    exec "$CACHE_DIR/$BIN_NAME$EXE" "$@"
fi
rm -f "$TMP"

# gh covers a machine without curl, and a release that is not public.
if command -v gh >/dev/null 2>&1 &&
   gh release download --repo "$REPO" -p "$ARTIFACT" -O "$TMP" --clobber >/dev/null; then
    chmod 0755 "$TMP"
    mv -f "$TMP" "$CACHE_DIR/$BIN_NAME$EXE"
    log "codeindex: fetched $ARTIFACT -> $CACHE_DIR/$BIN_NAME$EXE"
    exec "$CACHE_DIR/$BIN_NAME$EXE" "$@"
fi
rm -f "$TMP"

log "codeindex: no usable $BIN_NAME binary, and none could be fetched."
log "  searched: \$CODEINDEX_BIN, PATH, $HOME/.local/bin, $CACHE_DIR (as $BIN_NAME$EXE)"
log "  no release asset '$ARTIFACT' for $REPO"
log "  build it: git clone https://github.com/$REPO && cd codeindex && ./install.sh"
exit 127
